$downrank=5,site=tiktok.com
$downrank=5,site=twitter.com
$downrank=5,site=x.com
$downrank=5,site=linkedin.com
$downrank=5,site=truthsocial.com
$downrank=5,site=threads.net
$downrank=5,site=snapchat.com

