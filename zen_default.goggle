! name: Zen Default
! description: Downranks social media, SEO and content farms, paywalled news, e-commerce, and affiliate review sites. Boosts personal blogs, indie communities, open reference, non-profit journalism, and open access research.
! public: true
! author: wakingbuddhas

! ─────────────────────────────────────────────────────────────────
! DOWNRANK: Corporate mega-sites, walled gardens, SEO/content farms
! ─────────────────────────────────────────────────────────────────

! Social media walled gardens (JS-heavy, login walls, no useful search content)
$downrank=5,site=pinterest.com
$downrank=5,site=pinterest.co.uk
$downrank=5,site=pinterest.ca
$downrank=5,site=pinterest.fr
$downrank=5,site=pinterest.de
$downrank=5,site=instagram.com
